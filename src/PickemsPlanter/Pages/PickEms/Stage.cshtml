@page
@model PickemsPlanter.Pages.PickEms.StageModel
@{
    ViewData["Title"] = $"Pick'Ems Planter - {Model.Stage}";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/stagePlayoffs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/stage.css" asp-append-version="true" />
}

<div class="pickem-container">
    <div class="navbar">
        <h2 class="selected-event" id ="SelectedEvent" asp-for="SelectedEvent" value=@Model.SelectedEvent>@Model.EventName</h2>
        <div class="navigation" id="navigation">
            <div class="dropdown" id="dropDown">
                <a class="logout" onclick="toggleLogoutConfirmation()">Logout</a>
                <a class="profile" asp-page="/Profile/Overview">Event Overview</a>
            </div>
            <a class="profile-image" asp-page="/Profile/Overview"><img src="@Model.Avatar" /></a>
            <a class="profile-image-hidden" id="profileImage"><img src="@Model.Avatar" /></a>
        </div>
    </div>

    <div class="pickem-layout">
        <nav class="stage-nav">
            <a class="stage @(Model.Stage == PickemsPlanter.Models.Event.Stages.Stage1 ? "active" : "")"
               asp-page="/PickEms/Stage"
               asp-route-eventId="@Model.EventId"
               asp-route-eventName="@Model.EventName"
               asp-route-steamId="@Model.SteamId"
               asp-route-stage="@PickemsPlanter.Models.Event.Stages.Stage1">I</a>

            <a class="stage @(Model.Stage == PickemsPlanter.Models.Event.Stages.Stage2 ? "active" : "")"
               asp-page="/PickEms/Stage"
               asp-route-eventId="@Model.EventId"
               asp-route-eventName="@Model.EventName"
               asp-route-steamId="@Model.SteamId"
               asp-route-stage="@PickemsPlanter.Models.Event.Stages.Stage2">II</a>

            <a class="stage @(Model.Stage == PickemsPlanter.Models.Event.Stages.Stage3 ? "active" : "")"
               asp-page="/PickEms/Stage"
               asp-route-eventId="@Model.EventId"
               asp-route-eventName="@Model.EventName"
               asp-route-steamId="@Model.SteamId"
               asp-route-stage="@PickemsPlanter.Models.Event.Stages.Stage3">III</a>

            <a class="stage"
               asp-page="/PickEms/Playoffs"
               asp-route-eventId="@Model.EventId"
               asp-route-eventName="@Model.EventName"
               asp-route-steamId="@Model.SteamId">IV</a>
        </nav>

        <div class="content-row">
            <section class="teams-section" id="teamSection">
                <div class="picks-not-allowed-overlay" id="picksNotAllowedConfirmation">
                    <div class="picks-locked-card">
                        <img src="/Images/lock.png" />
                        Picks locked
                    </div>
                </div>
                <div class="team" id="team0"></div>
                <div class="team" id="team1"></div>
                <div class="team" id="team2"></div>
                <div class="team" id="team3"></div>
                <div class="team" id="team4"></div>
                <div class="team" id="team5"></div>
                <div class="team" id="team6"></div>
                <div class="team" id="team7"></div>
                <div class="team" id="team8"></div>
                <div class="team" id="team9"></div>
                <div class="team" id="team10"></div>
                <div class="team" id="team11"></div>
                <div class="team" id="team12"></div>
                <div class="team" id="team13"></div>
                <div class="team" id="team14"></div>
                <div class="team" id="team15"></div>
            </section>

            <section class="bracket-progression" id="bracketProgression">
                <partial name="_SwissBracket" />
            </section>

            <section class="bracket">
                <div class="picks">
                    <div class="three-zero">
                        <div class="dropzone-advanced" id="pick0" title="3-0">3-0</div>
                        <div class="dropzone-advanced" id="pick1" title="3-0">3-0</div>
                    </div>
                    <div class="three-one-two">
                        <div class="three-one">
                            <div class="dropzone-advanced" id="pick2" title="3-1">3-1</div>
                            <div class="dropzone-advanced" id="pick3" title="3-1">3-1</div>
                            <div class="dropzone-advanced" id="pick4" title="3-1">3-1</div>
                        </div>
                        <div class="three-two">
                            <div class="dropzone-advanced" id="pick5" title="3-2">3-2</div>
                            <div class="dropzone-advanced" id="pick6" title="3-2">3-2</div>
                            <div class="dropzone-advanced" id="pick7" title="3-2">3-2</div>
                        </div>
                    </div>
                    <div class="zero-three">
                        <div class="dropzone-eliminated" id="pick8" title="0-3">0-3</div>
                        <div class="dropzone-eliminated" id="pick9" title="0-3">0-3</div>
                    </div>
                </div>
            </section>
        </div>

        <div class="bottom-bar">
            <div class="show-results-div">
                <label class="toggle-label" title="Show the results from the stage">
                    <input type="checkbox" class="show-results" id="showResults" asp-page-handler="GetResults"/>
                    <span class="toggle-track"><span class="toggle-thumb"></span></span>
                    Show results
                </label>

                <div class="view-toggle-row" id="viewToggleRow" hidden>
                    <label class="toggle-label view-toggle" title="Switch between Simple and Bracket view">
                        <span class="view-toggle-option">Simple</span>
                        <input type="checkbox" id="viewToggleInput" />
                        <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        <span class="view-toggle-option">Bracket</span>
                    </label>
                    <div class="view-toggle-intro" id="viewToggleIntro" hidden>
                        <div class="view-toggle-intro-arrow"></div>
                        <p>New: switch to <strong>Bracket View</strong> to watch the whole Swiss stage fill in live as results come in.</p>
                        <button type="button" class="view-toggle-intro-dismiss" id="viewToggleIntroDismiss">Got it</button>
                    </div>
                </div>
            </div>
            <div class="buttons">
                <button class="clear-all-picks" id="clearAllPicks" type="button" title="Clear all picks"><img src="/Images/clear_all_picks.png" /></button>
                <button class="random-picks" id="randomPicks" type="button" title="Randomly fill the empty dropzones"><img src="/Images/random_picks.png" /></button>
                <button class="simulator" id="simulatorButton" type="button" title="Open Simulator"><img src="/Images/simulator.png" /></button>
            </div>
            <form method="post" class="save-form" id="saveForm">
                <input type="hidden" name="picksToPost" id="picksToPost" />
                <button class="save-button" type="submit" id="saveButton" title="Save your picks" asp-page-handler="SendPicks" asp-route-eventId="@Model.EventId" asp-route-steamId="@Model.SteamId" asp-route-stage="@Model.Stage" asp-route-eventName="@Model.EventName" disabled>Plant Picks</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.pageData = {
            eventId: "@Model.EventId",
            steamId: "@Model.SteamId",
            stage: "@Model.Stage",
            picks: [@Model.Picks]
        };
        // Bracket View embeds Simulator's bracket engine read-only (no manual clicks —
        // it only ever reflects real PandaScore results) and lazy-loads it itself the
        // first time the view is actually switched to, rather than on every page load.
        window.bracketViewReadOnly = true;
        window.bracketViewLazyInit = true;
    </script>
    <script src="~/js/PickEms/stylingFunctions.js"></script>
    <script src="~/js/PickEms/utilities.js"></script>
    <script src="~/js/PickEms/randomPicksFunctions.js"></script>
    <script src="~/js/PickEms/dropzoneFunctions.js"></script>
    <script src="~/js/PickEms/dropFunctions.js"></script>
    <script src="~/js/PickEms/dragFunctions.js"></script>
    <script src="~/js/PickEms/apiFunctions.js"></script>
    <script src="~/js/PickEms/stagePlayoffs.js"></script>
    <script src="~/js/PickEms/mobileFunctions.js"></script>
    <script src="~/js/PickEms/stage.js"></script>
    <script src="~/js/Simulator/simulator.js"></script>
    <script src="~/js/PickEms/viewToggle.js"></script>
}
