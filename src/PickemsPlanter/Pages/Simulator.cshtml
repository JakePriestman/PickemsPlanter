        <script src="~/js/PickEms/stylingFunctions.js"></script>
        <script src="~/js/Simulator/simulator.js"></script>
    </environment>

    <environment exclude="Development">
        <script src="/js/PickEms.bundle.min.js"></script>
        <script src="/js/Simulator.bundle.min.js"></script>
    </environment>
}