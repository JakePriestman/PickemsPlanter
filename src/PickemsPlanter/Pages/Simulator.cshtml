@page
@model PickemsPlanter.Pages.SimulatorModel
@{
    ViewData["Title"] = $"Pick'Ems Planter - Stage Simulator";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/simulator.css" asp-append-version="true" />
}

<partial name="_SwissBracket" />

@section Scripts {
    <script>
        window.pageData = {
            eventId: "@Model.EventId",
            stage: "@Model.Stage"
        };
    </script>
    <script src="~/js/PickEms/stylingFunctions.js"></script>
    <script src="~/js/Simulator/simulator.js"></script>
}
